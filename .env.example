# Бұл файл — үлгі. Нақты мәндерді Render панеліне немесе жергілікті терминалдың орта айнымалыларына енгізіңіз.
# Нақты кілттері бар .env файлын репозиторийге жібермеңіз.

# Gemini API кілті (https://aistudio.google.com → Get API key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Негізгі модельдің лимиті бітсе қолданылатын қосалқы модельдер (үтір арқылы)
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
# Қосалқы тегін ЖИ — Gemini жауап бермесе қолданылады (https://console.groq.com → API Keys)
GROQ_API_KEY=
# Groq модельдер тізбегі (бірінің минуттық лимиті бітсе — келесісі); бос қалса әдепкі тізбек қолданылады
BACKUP_AI_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b
# Басқа OpenAI-үйлесімді сервис үшін (мысалы, OpenRouter): BACKUP_AI_URL, BACKUP_AI_KEY, BACKUP_AI_NAME

# gemini | mock (mock — кілтсіз жергілікті тексеруге арналған жалған ЖИ)
AI_PROVIDER=gemini

# Firebase сервистік аккаунт кілтінің JSON мәтіні (бір жолға) немесе файл жолы
FIREBASE_CREDENTIALS_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\serviceAccount.json
# auto | firestore | local
STORAGE=auto

# Зерттеуші бетінің құпиясөзі
RESEARCHER_PASSWORD=
# Сессияларды қорғауға арналған кездейсоқ ұзын жол
SECRET_KEY=
# HTTPS арқылы жұмыс істегенде 1
SESSION_COOKIE_SECURE=0
